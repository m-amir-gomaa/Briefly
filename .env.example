# ============================================================
# Briefly Platform — Distributed Stack Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# The LEAD node provides DATABASE_URL and REDIS_URL to all
# other nodes. Run the lead node first, then update these
# values on worker nodes.
# ============================================================

# ── Your Identity ────────────────────────────────────────────
# Your Tailscale IP address. Run: tailscale ip -4
NODE_IP=100.x.x.x

# Your role in the cluster: "lead" or "worker"
# The lead node initializes the CockroachDB schema and Redis.
NODE_ROLE=lead

# ── AI Service ───────────────────────────────────────────────
# Required for the AI pipeline (Gemini 1.5 Flash)
# Get one at: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# ── Database (CockroachDB) ───────────────────────────────────
# LEAD NODE: use the local address below (already set correctly)
DATABASE_URL=postgres://root@crdb-alpha:26257/defaultdb?sslmode=disable

# WORKER NODE: replace <LEAD_IP> with the lead node's Tailscale IP
# DATABASE_URL=postgres://root@<LEAD_IP>:26257/defaultdb?sslmode=disable

# ── Cache & Queue (Redis) ────────────────────────────────────
# LEAD NODE: use the local address below (already set correctly)
REDIS_URL=redis://redis-alpha:6379

# WORKER NODE: replace <LEAD_IP> with the lead node's Tailscale IP
# REDIS_URL=redis://<LEAD_IP>:6379

# Set to "true" when connecting to a Redis Cluster (multi-node).
# Leave as "false" for single-node local dev.
REDIS_CLUSTER_MODE=false

# ── Object Storage (MinIO / Cloudflare R2) ───────────────────
# LEAD NODE: use the local MinIO container (already set correctly)
S3_ENDPOINT=minio-alpha:9000
S3_ACCESS_KEY=briefly_admin
S3_SECRET_KEY=briefly_storage_secret

# WORKER NODE: replace <LEAD_IP> with the lead node's Tailscale IP
# S3_ENDPOINT=<LEAD_IP>:9000

# ── Go API ───────────────────────────────────────────────────
# GC tuning: trade RAM for lower CPU pause times under load
GOGC=200

# Port the Go API listens on (each node can use 8080)
PORT=8080

# ── AI Worker ────────────────────────────────────────────────
# URL of the Go API that the AI worker calls back to after processing
# LEAD NODE:
API_URL=http://api-alpha:8080
# WORKER NODE: replace <LEAD_IP> with the lead node's Tailscale IP
# API_URL=http://<LEAD_IP>:8080
