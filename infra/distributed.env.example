# Briefly Distributed Platform Environment Template
# Copy this file to .env on each node and fill in the values.

# --- Core API Configuration ---
PORT=8080
GOOGLE_API_KEY=your_gemini_api_key_here
GIN_MODE=release

# --- Distributed Infrastructure ---
# The Tailscale IP of THIS node
NODE_IP=100.x.y.z

# CockroachDB Connection String (point to the Alpha node)
# Example: postgresql://root@100.x.y.alpha:26257/briefly?sslmode=disable
DATABASE_URL=postgresql://root@100.x.y.alpha:26257/briefly?sslmode=disable

# Redis Configuration (point to the Alpha node or Cluster)
REDIS_URL=redis://100.x.y.alpha:6379
REDIS_CLUSTER_MODE=true

# --- Object Storage (MinIO / S3) ---
S3_ENDPOINT=http://100.x.y.alpha:9000
S3_ACCESS_KEY=briefly_admin
S3_SECRET_KEY=briefly_secret_change_me
S3_BUCKET=briefly-intakes
S3_REGION=us-east-1

# --- Service Discovery ---
# The URL where the Go API can be reached by the AI workers
API_URL=http://100.x.y.z:8080
